    "student_search_settings": {
        "description": "关键词模糊匹配设置",
        "hint": "先用本地 SchaleDB 学生数据匹配主体和形态；可维护别名，并可选用大模型在本地候选中辅助排序",
        "type": "object",
        "items": {
            "custom_aliases": {
                "description": "学生别名",
                "type": "list",
                "default": [
                    "啊露=爱露",
                    "阿露=爱露",
                    "水星野=星野"
                ],
                "hint": "每行填写“别名=标准学生名”，例如“啊露=爱露”；预置别名可直接修改，也可以继续添加；只用于名称匹配，不会改变 SchaleDB 数据",
                "items": {
                    "type": "string"
                }
            },
            "arona_form_aliases": {
                "description": "形态词别名",
                "type": "list",
                "default": [
                    "レーシング=赛车",
                    "乐队=乐队",
                    "体操服=体操服",
                    "运动服=体操服",
                    "便服=便服",
                    "偶像=偶像",
                    "制服=制服",
                    "圣诞=圣诞",
                    "女仆=女仆",
                    "导游=导游",
                    "小=小",
                    "应援团=应援团",
                    "打工=打工",
                    "新年=正月",
                    "旗袍=旗袍",
                    "正月=正月",
                    "武装=临战",
                    "泳装=泳装",
                    "温泉=温泉",
                    "睡衣=睡衣",
                    "礼服=礼服",
                    "邦妮=兔女郎",
                    "露营=露营",
                    "野营=露营",
                    "骑行=骑行",
                    "自行车=骑行",
                    "单车=骑行",
                    "魔法=魔法",
                    "魔法少女=魔法",
                    "赛车=赛车",
                    "兔女郎=兔女郎"
                ],
                "hint": "每行填写“SchaleDB形态词=Arona形态词”；攻略查询会组合为“Arona形态词+主体名”；已预置当前 SchaleDB 学生数据中的形态词及已知别名，可修改或继续添加，只影响攻略查询名称转换；Arona 未收录攻略或仅返回模糊候选时，插件仍不会发送不确定的图片",
                "items": {
                    "type": "string"
                }
            },
            "llm_enabled": {
                "description": "启用大模型辅助匹配",
                "type": "bool",
                "default": false,
                "hint": "开启后，仅在学生候选菜单增加一个可选的辅助匹配入口；不会让大模型参与每次搜索，也不会允许模型创建候选角色"
            },
            "llm_provider_id": {
                "description": "辅助匹配模型 Provider ID",
                "type": "string",
                "default": "",
                "hint": "建议填写快速、非思考型小模型对应的 Provider ID；留空时尝试使用当前会话的聊天模型"
            },
            "llm_timeout_seconds": {
                "description": "辅助匹配超时时间（秒）",
                "type": "int",
                "default": 15,
                "hint": "有效范围为 3–120 秒，建议设置为 5–30 秒；超时或返回内容无法校验时，原候选菜单仍可正常使用"
            }
        }
    },
    "cache_settings": {
        "description": "生成卡片缓存",
        "hint": "限制已生成卡片图片的本地缓存；SchaleDB 数据文件和资源图片使用独立缓存策略",
        "type": "object",
        "items": {
            "max_items": {
                "type": "int",
                "default": 200,
                "description": "最大缓存图片数量，超过则按 LRU 清理最旧条目"
            },
            "max_size_mb": {
                "type": "int",
                "default": 500,
                "description": "最大缓存总大小 (MB)，超过则清理最旧条目"
            },
            "ttl_days": {
                "type": "int",
                "default": 7,
                "description": "缓存过期天数"
            }
        }
    },
    "polling_settings": {
        "description": "每日轮询、推送与卡片归档",
        "hint": "按本地时区每日生成所选卡片，并推送到“基础设置 → 会话区域与轮询推送群聊”中配置的群聊；Dashboard 会保存卡片、推送目标和逐群发送结果。未配置群聊时只生成并归档，不会推送",
        "type": "object",
        "items": {
            "enabled": {
                "type": "bool",
                "default": true,
                "description": "启用每日轮询"
            },
            "poll_time": {
                "type": "string",
                "default": "08:00",
                "description": "每日轮询时间",
                "hint": "使用 AstrBot 所在设备的本地时区，24 小时制 HH:MM"
            },
            "poll_region": {
                "type": "string",
                "default": "all",
                "options": [
                    "cn",
                    "global",
                    "jp",
                    "all"
                ],
                "description": "日程和千里眼轮询服务器"
            },
            "poll_categories": {
                "type": "list",
                "default": [
                    "schedule",
                    "birthday",
                    "pool"
                ],
                "description": "轮询卡片类别",
                "hint": "每行填写一个类别：schedule（日程）、birthday（生日）、pool（千里眼）",
                "items": {
                    "type": "string",
                    "options": [
                        "schedule",
                        "birthday",
                        "pool"
                    ]
                }
            },
            "retention_days": {
                "type": "int",
                "default": 30,
                "description": "轮询记录保留天数"
            }
        }
    },
    "debug_settings": {
        "description": "调试设置",
        "type": "object",
        "items": {
            "debug_log": {
                "type": "bool",
                "default": false,
                "description": "输出调试日志到控制台"
            }
        }
    }
}
